# ─── Jericho Platform — environment ───────────────────────────────────────────
# Copy to `.env.local` for development. Never commit real secrets.

# Database (PostgreSQL). The whole platform shares one database; modules add
# their own tables but isolation is by org_id, not by separate databases.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jericho

# ─── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Dev conveniences (NEVER set in production unless you mean it):
#   AUTH_DEV_LOGIN=1       passwordless developer login
#   AUTH_PASSWORD_LOGIN=1  email+password credentials login
AUTH_DEV_LOGIN=1

# SSO selection: none | oidc | boxyhq-saml
AUTH_SSO_PROVIDER=none
# OIDC (when AUTH_SSO_PROVIDER=oidc)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Google OAuth (optional, auto-enabled when both set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Platform admins (comma-separated emails) — gain impersonation + admin console.
PLATFORM_ADMIN_EMAILS=matt@jerichosecurity.com

# ─── Per-org secret encryption (AES-256-GCM master key) ───────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLATFORM_MASTER_KEY=

# ─── Shared integrations (defaults; orgs can override with encrypted secrets) ──
# Anthropic Claude — used by Compliance (Horizon) summaries and Studio assists.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Notifications (platform-wide fallback; per-org overrides live in org secrets).
# SMTP_URL is a nodemailer connection string, e.g. smtps://user:pass@smtp.host:465
SMTP_URL=
SMTP_FROM=no-reply@jerichosecurity.com
SLACK_DEFAULT_WEBHOOK=
TEAMS_DEFAULT_WEBHOOK=

# ─── Scheduler (platform cron) ────────────────────────────────────────────────
# Shared secret the external scheduler sends to /api/cron/<job>. Generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# The cron endpoint is closed (401) until this is set. See docs/DEPLOYMENT.md.
CRON_SECRET=

# ─── Droplet / Docker deployment (see docs/DEPLOYMENT.md) ─────────────────────
# Domain Caddy provisions TLS for. Leave as localhost for a non-TLS local run.
DOMAIN=localhost
# Internal Postgres password (the db service is not exposed to the host).
POSTGRES_PASSWORD=postgres
# In Docker, DATABASE_URL is set by docker-compose to the `db` service, so the
# value at the top of this file is only used for local (non-Docker) development.
